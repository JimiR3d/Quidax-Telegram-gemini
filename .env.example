# ─── Core AI Keys ────────────────────────────────────────────────────────────
GROQ_API_KEY="your-groq-api-key"
GEMINI_API_KEY="your-gemini-api-key"

# ─── Authentication ───────────────────────────────────────────────────────────
# DASHBOARD_PASSWORD replaces VITE_DASHBOARD_PASSWORD.
# The server reads this — it is NEVER sent to the browser bundle.
DASHBOARD_PASSWORD="your-secure-dashboard-password"
SUPPORT_API_KEY="your-support-api-key"

# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# SUPABASE_ANON_KEY is no longer used — server uses SERVICE_ROLE_KEY only.

# ─── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""
TELEGRAM_SESSION_STRING=""
TELEGRAM_GROUP_USERNAME="OfficialQuidaxCommunity"
# Comma-separated Telegram user IDs that are always treated as admins (fast-path,
# no API call needed). Replies from these users are learned as keywords and linked
# to parent tickets. To find your Telegram user ID: message @userinfobot on Telegram
# and it will reply with your numeric user ID (e.g. 123456789).
# Example: TELEGRAM_ADMIN_USER_IDS="123456789,987654321"
TELEGRAM_ADMIN_USER_IDS=""
# Milliseconds to wait before the FIRST Telegram connect on startup. Guards
# against Railway's rolling-deploy overlap: the new container would otherwise
# connect while the old one still holds the session, and the resulting
# AUTH_KEY_DUPLICATED permanently burns the session string. Default 60000 (60s),
# clamped to 5 min; set "0" to disable (e.g. a cold first deploy with no old
# container). Only the initial connect is delayed — reconnects are not.
TELEGRAM_CONNECT_DELAY_MS=""
# The group ID support-role users are scoped to
SUPPORT_GROUP_ID="OfficialQuidaxCommunity"
# Comma-separated sender HASHES (as stored in messages.sender_hash) the
# reconciliation sweep must never resurrect as user tickets. The sweep derives
# admin hashes from admin-authored tickets, but that set is sparse — a new
# support admin who has never authored a ticket is invisible to it, and their
# dropped replies could be rebuilt as bogus USER tickets. List known admin
# hashes here as a backstop. Example: ADMIN_SENDER_HASHES="7b08fcbe...,ab12cd34..."
ADMIN_SENDER_HASHES=""

# ─── Automated Status Update Bot (Milestone 5) ───────────────────────────────
# When an admin changes a ticket status in the dashboard (to Resolved,
# Escalated, or Awaiting User), the bot replies to the user's original message
# in the Telegram group. TWO flags guard real posting:
# Kill switch — unset or "false" disables the feature completely (no logs, no
# dry-run, nothing).
BOT_REPLIES_ENABLED="false"
# Dry-run defaults to TRUE even when enabled: the full eligibility pipeline
# runs and records what WOULD be sent (bot_replies table + logs), but Telegram
# is never called. Set to "false" ONLY after reviewing production dry-run
# output — that makes it post to the real community group.
BOT_REPLIES_DRY_RUN="true"

# ─── Live Telegram Listener (Phase 2 — getChannelDifference) ─────────────────
# GramJS 2.26.x never syncs the supergroup's channel pts, so the live NewMessage
# listener delivers nothing and AutoFetch (3-min sweep) carries all ingestion
# (KNOWN_ISSUES §6 item 1). When "true", the server actively tracks the channel
# pts and polls updates.GetChannelDifference every 15s, feeding new messages into
# the same idempotent pipeline — target sub-15s ingest lag. Additive to AutoFetch
# (which stays the safety net). Default OFF; flip to "true" only in production
# (the live leg cannot be exercised on the no-telegram launcher).
CHANNEL_DIFF_ENABLED="false"

# ─── Outage-gap recovery (P0-2) ──────────────────────────────────────────────
# AutoFetch only looks back 2 hours, so an outage LONGER than 2h (a slow deploy,
# a crash, a Railway incident) loses the messages in the gap beyond it forever.
# When "true", on startup and after each watchdog reconnect the server pages
# Telegram history from the newest telegram_message_id it has already stored (the
# messages table IS the durable checkpoint) and replays anything newer through
# the same idempotent pipeline. A healthy, up-to-date system recovers nothing
# (one cheap call). Default OFF; enable in production after a verified-inert
# deploy. The live getMessages leg cannot be exercised on the no-telegram
# launcher. See /api/health.lastGapRecovery for the last run.
GAP_RECOVERY_ENABLED="false"
# Safety caps so a catastrophic (multi-day) gap can never spin an unbounded
# backfill: stop after this many recovered messages, or once paging reaches back
# past this many hours (older messages in the gap are then unrecoverable, logged
# loudly). Defaults 500 and 24.
GAP_RECOVERY_MAX_MESSAGES=""
GAP_RECOVERY_MAX_AGE_HOURS=""

# ─── Jira Integration (optional) ──────────────────────────────────────────────
JIRA_BASE_URL="https://your-org.atlassian.net"
JIRA_EMAIL="your-email@company.com"
JIRA_API_TOKEN="your-jira-api-token"
JIRA_PROJECT_KEY="SUP"

# ─── Monitoring ───────────────────────────────────────────────────────────────
# URL pinged every 5 minutes as a heartbeat (e.g. BetterUptime, UptimeRobot)
HEARTBEAT_URL=""

# ─── Observability / Alerting (ingest-lag gauge + session-liveness alarm) ────
# /api/health.ingestLag reports median/max lag (ingested_at - message_timestamp)
# over the last 50 messages rows, refreshed every 60s. If the median lag stays
# above this threshold for 5+ continuous minutes, an alert fires (log + the
# webhook below). Default 600000 (10 min).
INGEST_LAG_ALERT_MS=""
# If the Telegram session (telegramReady && client.connected) stays down for
# this long continuously, an alert fires. Default 600000 (10 min). Only
# evaluated when Telegram is actually configured (TELEGRAM_API_ID/HASH/
# SESSION_STRING all set) — never fires on the no-telegram launcher.
SESSION_DOWN_ALERT_MS=""
# Optional POST target for both alerts above: JSON body {source, message, at}.
# Alerts are always logged regardless of whether this is set. Once an alert
# fires it will not re-fire for the same ongoing breach for 30 minutes.
ALERT_WEBHOOK_URL=""

# ─── Environment ──────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT="3000"
ENABLE_BETA_FEATURES="false"
APP_URL="http://localhost:3000"

# ─── Demo Mode ────────────────────────────────────────────────────────────────
# Set to "true" to return sample tickets without querying Supabase.
DEMO_MODE="false"

# ─── Eval ─────────────────────────────────────────────────────────────────────
EVAL_BASE_URL="http://localhost:3000"

# ─── DEPRECATED — do not use ──────────────────────────────────────────────────
# VITE_DASHBOARD_PASSWORD — removed. Password is no longer in the Vite bundle.
# If you still have this set, the server will accept it as a fallback for one
# release cycle. Remove it from your environment as soon as possible.
