# GROQ_API_KEY: Required for Groq API calls.
# Users configure this via the Settings -> Secrets panel in the AI Studio UI.
GROQ_API_KEY="MY_GROQ_API_KEY"

# ENVIRONMENT DEPLOYMENT (dev / staging / production)
# Prevents testing on localhost from affecting production.
NODE_ENV="development"
ENABLE_BETA_FEATURES="false" # Feature flags for phased rollouts

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"

# TELEGRAM (Optional for now, for live listener)
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""
TELEGRAM_SESSION_STRING=""
TELEGRAM_GROUP_USERNAME="OfficialQuidaxCommunity"

# PASSWORDS
VITE_DASHBOARD_PASSWORD="your-admin-password-here"
SUPPORT_API_KEY="your-support-api-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"
