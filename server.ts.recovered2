  // ── Protected: tickets (T2-D server-side pagination + filtering) ──────────
  app.get("/api/tickets", requireAuth, async (req, res) => {
    // Demo mode (Feature 5)
    if (process.env.DEMO_MODE === "true") {
      const page     = Math.max(0, parseInt(req.query.page as string || "0"));
      const pageSize = Math.min(50, Math.max(1, parseInt(req.query.pageSize as string || "50")));
      let demo = [...DEMO_TICKETS];
      // Issues-only: exclude non-essential categories AND Low urgency (same logic as live path)
      if (req.query.issues_only === "true") {
        demo = demo.filter(t => !NON_ESSENTIAL_CATEGORIES.has(t.category) && t.urgency !== "Low");
      }
      if (req.query.urgency && req.query.urgency !== "All") {
        demo = demo.filter(t => t.urgency === req.query.urgency);
      }
      const total = demo.length;
      const tickets = demo.slice(page * pageSize, (page + 1) * pageSize);
      return res.json({ tickets, total, page, pageSize });
    }

    try {
      const supabase = getSupabase();
      const user     = (req as any).user;

      // Parse pagination params
      const page     = Math.max(0, parseInt(req.query.page as string || "0"));
      const from     = page * pageSize;
      const to       = from + pageSize - 1;

      let query = supabase
        .from("tickets")
        .select("*", { count: "exact" })
        .order("created_at", { ascending: false })
        .range(from, to);

      let statsQuery = supabase
        .from("tickets")
        .select("id, status, urgency, created_at");

      // Base filters apply to BOTH stats and the table list
      const applyBaseFilters = (q: any) => {
        let temp = q;
        if (user.role === "support") {
          temp = temp.eq("group_id", user.tenantId);
        } else if (req.query.group_id) {
          temp = temp.eq("group_id", req.query.group_id as string);
        }

        if (req.query.issues_only === "true") {
          const nonEssStr = NON_ESSENTIAL_CATEGORIES.map(c => `"${c}"`).join(",");
          temp = temp.or(`summary.eq."Processing message...",and(urgency.neq.Low,category.not.in.(${nonEssStr}))`);
        }

        if (req.query.days && req.query.days !== "All" && req.query.days !== "Custom") {
          const days = parseInt(req.query.days as string);
          if (!isNaN(days)) {
             const d = new Date();
             d.setDate(d.getDate() - (days - 1));
             d.setHours(0,0,0,0);
             temp = temp.gte("created_at", d.toISOString());
          }
        }
        if (req.query.days === "Custom") {
          if (req.query.startDate) temp = temp.gte("created_at", req.query.startDate as string);
          if (req.query.endDate) temp = temp.lte("created_at", req.query.endDate as string);
        }
        if (req.query.search) {
          temp = temp
        if (req.query.search) {
          temp = temp.or(`summary.ilike.%${req.query.search}%,category.ilike.%${req.query.search}%,raw_text.ilike.%${req.query.search}%`);
        }

        return temp;
      };

      // Table-specific filters ONLY apply to the list query, not the global stats
          if (req.query.startDate) temp = temp.gte("created_at", req.query.startDate as string);
          if (req.query.endDate) temp = temp.lte("created_at", req.query.endDate as string);
        }
        if (req.query.search) {
          temp = temp.or(`summary.ilike.%${req.query.search}%,category.ilike.%${req.query.search}%,raw_text.ilike.%${req.query.search}%`);
        }

        return temp;
        }
        return temp;
      };

      query = applyTableFilters(applyBaseFilters(query));
      statsQuery = applyBaseFilters(statsQuery);

      const [ { data, error, count }, { data: statsData, error: statsError } ] = await Promise.all([
        query,
        statsQuery
      ]);

      if (error) throw error;
      if (statsError) throw statsError;

      const now = new Date();
      const isToday = (d: Date) => d.getDate() === now.getDate() && d.getMonth() === now.getMonth() && d.getFullYear() === now.getFullYear();

      const allData = statsData || [];
      const resolved = allData.filter(t => t.status === "Resolved");
      const openOrReview = allData.filter(t => t.status === "Open" || t.status === "In Review");
      
      const stats = {
        openCount: allData.filter(t => t.status === "Open").length,
        resolvedCount: resolved.length,
        criticalCount: allData.filter(t => t.urgency === "Critical" && t.status !== "Resolved" && t.status !== "Dismissed").length,
        highCount: allData.filter(t => t.urgency === "High" && t.status !== "Resolved" && t.status !== "Dismissed").length,
        mediumCount: allData.filter(t => t.urgency === "Medium" && t.status !== "Resolved" && t.status !== "Dismissed").length,
        lowCount: allData.filter(t => t.urgency === "Low" && t.status !== "Resolved" && t.status !== "Dismissed").length,
        ticketsTodayCount: allData.filter(t => isToday(new Date(t.created_at))).length,
        totalCount: count ?? 0,
        resolutionRate: allData.length > 0 ? Math.round((resolved.length / allData.length) * 100) : 0,
