            product_area: "Other",
            sentiment: "Neutral",
            is_complaint: false,
            suggested_action: "None",
          };
        } else {
          const safeText = redactPII(sanitizeForPrompt(text));
          const response = await groqBreaker.call(() =>
            withTimeout(
              openai.chat.completions.create({
                model: "llama-3.3-70b-versatile",
