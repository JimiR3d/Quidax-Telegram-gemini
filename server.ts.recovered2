        .from("learned_keywords")
        .select("frequency")
        .eq("keyword", keyword)
        .maybeSingle();

      if (existing) {
        await supabase
          .from("learned_keywords")
          .update({ frequency: existing.frequency + 1, updated_at: now })
          .eq("keyword", keyword);
      } else {
        await supabase
          .from("l
