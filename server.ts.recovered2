  const distIndexPath = path.join(process.cwd(), "dist", "index.html");
  const isBuilt = fs.existsSync(distIndexPath);

  if (isBuilt) {
    // Serve the pre-built Vite output (production / npm start)
    const distPath = path.join(process.cwd(), "dist");
    // Serve assets folder explicitly
    app.use("/assets", express.static(path.join(distPath, "assets")));
    // Serve any other static files that land in dist root (favicon etc)
    app.use(express.static(distPath));
    // Final catch-all — app.use with NO path always matches everything,
    // including bare "/" which app.get("*") misses in Express 4.21+
    app.use((_req: express.Request, res: express.Response) => {
      res.sendFile(distIndexPath);
    });
    logger.info("Server", `Serving built frontend from ${distPath}`);
  } else {
