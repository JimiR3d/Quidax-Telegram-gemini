      .select("id")
      .single();

    if (msgError) {
      if (msgError.code === "23505") {
        // UNIQUE constraint violation — already exists
        logger.debug("Ingestion", `Duplicate message detected for telegramId ${telegramId}`);
        return null;
      }
      throw new Error(`DB Error inserting message: ${msgError.message}`);
    }

    // ── Insert ticket (pending state) ────────────────────────────────────────

      throw new Error(`DB Error inserting ticket: ${ticketError.message}`);
    }

    // ── Async classification ─────────────────────────────────────────────────
    (async () => {
      try {
        let ticketData;
        let suggestedReply = "";

        if (isPreFiltered) {
          ticketData = {
            summary: "General Chat",
            category: "Other",
            urgency: "Low",
            product_area: "Other",
            sentiment: "Neutral",
            is_complaint: false,
