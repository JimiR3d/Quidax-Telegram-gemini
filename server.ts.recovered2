  console.log('\n═══════════════════════════════════════════════════════════');
  console.log(' RESULTS SUMMARY');
  console.log('═══════════════════════════════════════════════════════════');
  console.log(`  Category Accuracy:  ${catAcc}/${n}  (${Math.round(catAcc/n*100)}%)`);
  console.log(`  Urgency Accuracy:   ${urgAcc}/${n}  (${Math.round(urgAcc/n*100)}%)`);
  console.log(`  Sentiment Accuracy: ${sentAcc}/${n}  (${Math.round(sentAcc/n*100)}%)`);
  console.log(`  All-3 Pass Rate:    ${allAcc}/${n}  (${Math.round(allAcc/n*100)}%)`);
  console.log('═══════════════════════════════════════════════════════════');

  const failures = results.filter(r => !r.allOk);
  if (failures.length > 0) {
    console.log('\n FAILURES — Expected vs Got:');
    failures.forEach((f, i) => {
      console.log(`\n  [${i + 1}] "${f.message.slice(0, 70)}"`);
      if (!f.catOk)  console.log(`       Category:  expected "${f.expected.category}"  got "${f.got.category}"`);
      if (!f.urgOk)  console.log(`       Urgency:   expected "${f.expected.urgency}"   got "${f.got.urgency}"`);
      if (!f.sentOk) console.log(`       Sentiment: expected "${f.expected.sentiment}" got "${f.got.sentiment}"`);
    });
  }

  console.log('\n Run again with: npx tsx eval.ts\n');
}

// Run if called directly
runBenchmark().catch(console.error);
```

-----

### FEATURE 7: Urgency Filter Buttons in Dashboard

**File:** `src/App.tsx`

Add state:

```typescript
const [urgencyFilter, setUrgencyFilter] = React.useState<string>('All');
```

Add the filter bar above the ticket list (inside the dashboard area):

```tsx
<div className="flex items-center gap-2 px-4 py-2 flex-wrap">
  {(['All', 'Critical', 'High', 'Medium'] as const).map(level => (
    <button
      key={level}
      onClick={() => setUrgencyFilter(level)}
      className={`px-3 py-1 rounded-full text-xs font-semibold transition-colors ${
        urgencyFilter === level
          ? level === 'Critical' ? 'bg-red-600 text-white'
          : level === 'High'     ? 'bg-orange-500 text-white'
          : level === 'Medium'   ? 'bg-yellow-500 text-black'
          : 'bg-white text-black'
          : 'bg-zinc-800 text-zinc-400 hover:bg-zinc-700'
      }`}
    >
      {level === 'Critical' ? '🔴 ' : level === 'High' ? '🟠 ' : level === 'Medium' ? '🟡 ' : ''}
      {level}
    </button>
  ))}
</div>
```

Apply the filter in the existing `filteredTickets` useMemo (add urgency to the filter conditions):

```typescript
const filteredTickets = React.useMemo(() =>
  tickets.filter(t =>
    (urgencyFilter === 'All' || t.urgency === urgencyFilter) &&
